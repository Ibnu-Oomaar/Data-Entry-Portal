{
  "name": "classes-portal-backend",
  "version": "1.0.0",
  "description": "Classes Data Entry Portal - NestJS API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "bun dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "NODE_ENV=production bun dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns 'src/.*\\.spec\\.ts$'",
    "test:e2e": "jest --runInBand --testPathPatterns 'test/.*\\.e2e-spec\\.ts$'",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "bun run typeorm -- migration:generate",
    "migration:run": "bun dist/cli/migrate.js",
    "migration:run:dev": "bun src/cli/migrate.ts",
    "import:students": "bun src/cli/import-students.ts",
    "import:students:prod": "bun dist/cli/import-students.js",
    "teacher": "bun src/cli/teachers.ts",
    "teacher:prod": "bun dist/cli/teachers.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/typeorm": "^11.0.3",
    "@simplewebauthn/server": "^14.1.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
